    {
      "id": "gtZU1QQqKSFLLfsmyiQJG",
      "type": "text",
      "x": 6165.464528795035,
      "y": 13.241707496886477,
      "width": 1201.945556640625,
      "height": 1111.6071428571433,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b14",
      "roundness": null,
      "seed": 699686997,
      "version": 1397,
      "versionNonce": 817110961,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1777164415900,
      "link": null,
      "locked": false,
      "text": "Additional Notes:\n\nVersion 1:\n- Each section has more space for content since \nit'll be on a page instead of a card\n- Navbar links on top can make up for scrolling\n- More traditional and safe\n- Easier to implement\n\nVersion 2:\n- Shows ambition and creativity, stands out more\n- Scrolling may be reduced, but the action of changing cards is added\n    - UX is less intuitive as a result\n- UI is more creative and modern\n- For changing cards, more efficient way can be implemented\n    - Using arrow keys\n    - Placing cursor in card and scrolling\n    - Still doesn't feel intuitive and may need to add instructions\n- Might be more suitable for frontend developer/designer\n\nOther:\n- No contact form, sticking with icon links directing users to\nemail or my socials\n    - Easier to implement\n- Should I think about mobile/tablet views now or later?",
      "fontSize": 35.571428571428584,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Additional Notes:\n\nVersion 1:\n- Each section has more space for content since \nit'll be on a page instead of a card\n- Navbar links on top can make up for scrolling\n- More traditional and safe\n- Easier to implement\n\nVersion 2:\n- Shows ambition and creativity, stands out more\n- Scrolling may be reduced, but the action of changing cards is added\n    - UX is less intuitive as a result\n- UI is more creative and modern\n- For changing cards, more efficient way can be implemented\n    - Using arrow keys\n    - Placing cursor in card and scrolling\n    - Still doesn't feel intuitive and may need to add instructions\n- Might be more suitable for frontend developer/designer\n\nOther:\n- No contact form, sticking with icon links directing users to\nemail or my socials\n    - Easier to implement\n- Should I think about mobile/tablet views now or later?",
      "autoResize": true,
      "lineHeight": 1.25
    },
